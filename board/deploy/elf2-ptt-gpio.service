[Unit]
Description=ELF2 PTT / BUSY GPIO preparation (PTT=GPIO3_A1/97, BUSY=GPIO3_A5/101)
Before=relay-web.service

[Service]
Type=oneshot
Environment=RELAY_PTT_GPIO=97
Environment=RELAY_BUSY_GPIO=101
ExecStart=/usr/local/sbin/elf2-ptt-gpio.sh
ExecStartPost=/bin/sh -c 'udevadm settle; for n in 97 101; do for f in direction value active_low edge; do chown elf:elf /sys/class/gpio/gpio$n/$f 2>/dev/null || true; chmod ug+rw /sys/class/gpio/gpio$n/$f 2>/dev/null || true; done; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
